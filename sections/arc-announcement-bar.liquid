{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Announcement Bar
  Section: arc-announcement-bar
  ════════════════════════════════════════════════
  Top-of-page banner on dark plum.
  Supports optional link and dismiss button.
  ════════════════════════════════════════════════
{%- endcomment -%}

{%- if section.settings.show_bar -%}
  <div
    class="arc-announce"
    id="arc-announce-{{ section.id }}"
    data-section-id="{{ section.id }}"
    role="banner"
    aria-label="Announcement"
  >
    <div class="arc-announce__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="arc-announce__link">
      {%- endif -%}

      <p class="arc-announce__text">
        {%- if section.settings.icon != blank -%}
          <span class="arc-announce__icon">{{ section.settings.icon }}</span>
        {%- endif -%}
        {{ section.settings.text }}
        {%- if section.settings.link_text != blank and section.settings.link != blank -%}
          <span class="arc-announce__cta">{{ section.settings.link_text }}</span>
        {%- endif -%}
      </p>

      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}

      {%- if section.settings.show_dismiss -%}
        <button
          class="arc-announce__dismiss"
          aria-label="Dismiss announcement"
          onclick="this.closest('.arc-announce').style.display='none'"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="2" y1="2" x2="12" y2="12"/><line x1="12" y1="2" x2="2" y2="12"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ── Announcement Bar ── */
  .arc-announce {
    --_bg: var(--arc-plum-dark);
    --_text: #F1E1DD;

    background: var(--_bg);
    color: var(--_text);
    padding: 0;
    position: relative;
    z-index: 110;
    overflow: hidden;
  }

  .arc-announce__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10px 40px 10px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
  }

  .arc-announce__link {
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }

  .arc-announce__text {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .arc-announce__icon {
    font-size: 13.8px;
    flex-shrink: 0;
  }

  .arc-announce__cta {
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
    white-space: nowrap;
  }

  .arc-announce__dismiss {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 4px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .arc-announce__dismiss:hover {
    opacity: 1;
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    .arc-announce__inner {
      padding: 8px 36px 8px 16px;
    }
    .arc-announce__text {
      font-size: 11.96px;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "arc-section-announce",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "New Spring arrivals — Fresh book boxes and signed editions are here."
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (emoji or text)",
      "default": "✦",
      "info": "Optional icon before the text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop now",
      "info": "Underlined text at the end of the announcement"
    },
    {
      "type": "checkbox",
      "id": "show_dismiss",
      "label": "Show dismiss button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
