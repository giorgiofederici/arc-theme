{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Collections List Page
  Section: arc-collections-list
  ════════════════════════════════════════════════
  Stacked layout: one row per collection with
  title, description, horizontal product carousel,
  and "See all" link.
  ════════════════════════════════════════════════

  SETUP:
  1. Upload to sections/
  2. Create templates/list-collections.arc.json with:
     { "sections": { "main": { "type": "arc-collections-list" } }, "order": ["main"] }
  3. Assign to your /collections page via theme editor
  ════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign products_per_carousel = section.settings.products_per_carousel | default: 4
-%}

<style>
  /* Reset Dawn wrapper */
  #shopify-section-{{ section.id }} {
    background: var(--bg-primary) !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ═══ PAGE HEADER ═══ */
  .arc-cls-header {
    padding: 48px 32px 32px !important;
    max-width: 900px !important;
    margin: 0 auto !important;
    text-align: center !important;
  }
  .arc-cls-header__overline {
    font-family: var(--font-body) !important;
    font-size: 13.8px!important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: var(--accent-primary) !important;
    margin-bottom: 8px !important;
  }
  .arc-cls-header__title {
    font-family: var(--font-heading) !important;
    font-size: clamp(2.3rem, 4.6vw, 3.22rem)!important;
    color: var(--text-heading) !important;
    margin: 0 0 12px !important;
    font-weight: normal !important;
    line-height: 1.15 !important;
  }
  .arc-cls-header__desc {
    font-family: var(--font-body) !important;
    font-size: 18.4px!important;
    color: var(--text-muted) !important;
    max-width: 560px !important;
    margin: 0 auto !important;
    line-height: 1.6 !important;
  }

  /* ═══ COLLECTION ROW ═══ */
  .arc-cls-row {
    max-width: 1300px !important;
    margin: 0 auto !important;
    padding: 40px 32px !important;
    border-top: 1px solid var(--border-subtle) !important;
  }
  .arc-cls-row:first-of-type {
    border-top: none !important;
  }

  /* ── Row header ── */
  .arc-cls-row__header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: flex-end !important;
    margin-bottom: 24px !important;
    gap: 24px !important;
    flex-wrap: wrap !important;
  }
  .arc-cls-row__heading {
    flex: 1 !important;
    min-width: 250px !important;
  }
  .arc-cls-row__overline {
    font-family: var(--font-body) !important;
    font-size: 12.65px!important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    color: var(--text-tertiary) !important;
    margin-bottom: 6px !important;
  }
  .arc-cls-row__title {
    font-family: var(--font-heading) !important;
    font-size: clamp(1.61rem, 2.875vw, 2.07rem)!important;
    color: var(--text-heading) !important;
    line-height: 1.2 !important;
    margin: 0 0 6px !important;
    font-weight: normal !important;
    text-decoration: none !important;
  }
  .arc-cls-row__title:hover {
    color: var(--accent-primary) !important;
  }
  .arc-cls-row__desc {
    font-family: var(--font-body) !important;
    font-size: 16.1px!important;
    color: var(--text-muted) !important;
    line-height: 1.6 !important;
    max-width: 500px !important;
  }
  .arc-cls-row__cta {
    font-family: var(--font-body) !important;
    font-size: 14.95px!important;
    color: var(--accent-primary) !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 8px 16px !important;
    border: 1px solid var(--accent-primary) !important;
    border-radius: 8px !important;
    background: transparent !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    white-space: nowrap !important;
  }
  .arc-cls-row__cta:hover {
    background: var(--accent-primary) !important;
    color: var(--bg-primary) !important;
  }
  .arc-cls-row__cta-arrow {
    display: inline-block !important;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }
  .arc-cls-row__cta:hover .arc-cls-row__cta-arrow {
    transform: translateX(3px) !important;
  }

  /* ═══ CAROUSEL ═══ */
  .arc-cls-carousel {
    position: relative !important;
  }
  .arc-cls-carousel__track-wrap {
    overflow: hidden !important;
    position: relative !important;
    margin: 0 -4px !important;
  }
  .arc-cls-carousel__track {
    display: flex !important;
    gap: 16px !important;
    overflow-x: auto !important;
    scroll-behavior: smooth !important;
    scroll-snap-type: x mandatory !important;
    padding: 4px !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
  }
  .arc-cls-carousel__track::-webkit-scrollbar {
    display: none !important;
  }
  .arc-cls-carousel__item {
    flex: 0 0 calc((100% - 48px) / 4) !important;
    scroll-snap-align: start !important;
    min-width: 200px !important;
  }

  /* ── Carousel arrows ── */
  .arc-cls-carousel__btn {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: var(--bg-elevated) !important;
    border: 1px solid var(--border-subtle) !important;
    color: var(--text-heading) !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 10 !important;
    font-size: 18.4px!important;
    font-family: var(--font-body) !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 0 4px 12px rgba(21, 29, 44, 0.08) !important;
  }
  .arc-cls-carousel__btn:hover {
    background: var(--accent-primary) !important;
    color: var(--bg-primary) !important;
    border-color: var(--accent-primary) !important;
    transform: translateY(-50%) scale(1.05) !important;
  }
  .arc-cls-carousel__btn:disabled {
    opacity: 0.3 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }
  .arc-cls-carousel__btn--prev { left: -16px !important; }
  .arc-cls-carousel__btn--next { right: -16px !important; }

  /* ═══ EMPTY STATE ═══ */
  .arc-cls-empty {
    text-align: center !important;
    padding: 80px 32px !important;
    font-family: var(--font-body) !important;
    color: var(--text-muted) !important;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 1024px) {
    .arc-cls-carousel__item { flex: 0 0 calc((100% - 32px) / 3) !important; }
  }
  @media (max-width: 768px) {
    .arc-cls-header { padding: 36px 20px 20px !important; }
    .arc-cls-row { padding: 32px 20px !important; }
    .arc-cls-row__header { flex-direction: column !important; align-items: flex-start !important; }
    .arc-cls-carousel__item { flex: 0 0 calc((100% - 16px) / 2) !important; }
    .arc-cls-carousel__btn { display: none !important; font-size: 18.4px;
  }
  }
  @media (max-width: 480px) {
    .arc-cls-carousel__item { flex: 0 0 75% !important; min-width: 180px !important; }
  }
</style>

{%- comment -%} ── Page Header ── {%- endcomment -%}
<div class="arc-cls-header">
  <div class="arc-cls-header__overline">{{ section.settings.overline | default: 'Browse Our Shelves' }}</div>
  <h1 class="arc-cls-header__title">{{ section.settings.heading | default: 'Collections' }}</h1>
  {%- if section.settings.description != blank -%}
    <div class="arc-cls-header__desc">{{ section.settings.description }}</div>
  {%- endif -%}
</div>

{%- comment -%} ── Collection Rows ── {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'collection_row' -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        <div class="arc-cls-row" data-carousel="row-{{ block.id }}" {{ block.shopify_attributes }}>

          {%- comment -%} Row header {%- endcomment -%}
          <div class="arc-cls-row__header">
            <div class="arc-cls-row__heading">
              <div class="arc-cls-row__overline">{{ collection.products_count }} {{ collection.products_count | pluralize: 'item', 'items' }}</div>
              <a href="{{ collection.url }}" class="arc-cls-row__title-link" style="text-decoration:none">
                <h2 class="arc-cls-row__title">{{ block.settings.custom_title | default: collection.title }}</h2>
              </a>
              {%- if block.settings.custom_description != blank -%}
                <div class="arc-cls-row__desc">{{ block.settings.custom_description }}</div>
              {%- elsif collection.description != blank -%}
                <div class="arc-cls-row__desc">{{ collection.description | strip_html | truncate: 160 }}</div>
              {%- endif -%}
            </div>
            <a href="{{ collection.url }}" class="arc-cls-row__cta">
              {{ block.settings.cta_text | default: 'See all' }} <span class="arc-cls-row__cta-arrow">&rarr;</span>
            </a>
          </div>

          {%- comment -%} Carousel {%- endcomment -%}
          <div class="arc-cls-carousel">
            <button
              class="arc-cls-carousel__btn arc-cls-carousel__btn--prev"
              aria-label="Previous"
              data-carousel-prev="row-{{ block.id }}"
            >&larr;</button>
            <div class="arc-cls-carousel__track-wrap">
              <div class="arc-cls-carousel__track" data-carousel-track="row-{{ block.id }}">
                {%- for product in collection.products limit: products_per_carousel -%}
                  <div class="arc-cls-carousel__item">
                    {%- render 'arc-product-card', product: product, lazy_load: true -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
            <button
              class="arc-cls-carousel__btn arc-cls-carousel__btn--next"
              aria-label="Next"
              data-carousel-next="row-{{ block.id }}"
            >&rarr;</button>
          </div>

        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  <div class="arc-cls-empty">
    <p>Add collection rows from the theme editor.</p>
  </div>
{%- endif -%}

<script>
(function() {
  document.querySelectorAll('[data-carousel-track]').forEach(function(track) {
    var id = track.getAttribute('data-carousel-track');
    var prevBtn = document.querySelector('[data-carousel-prev="' + id + '"]');
    var nextBtn = document.querySelector('[data-carousel-next="' + id + '"]');

    function updateButtons() {
      if (!prevBtn || !nextBtn) return;
      var atStart = track.scrollLeft <= 5;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }

    function scrollCarousel(direction) {
      var firstItem = track.querySelector('.arc-cls-carousel__item');
      if (!firstItem) return;
      var gap = 16;
      var itemWidth = firstItem.offsetWidth + gap;
      var visibleItems = Math.floor(track.clientWidth / itemWidth);
      var scrollAmount = itemWidth * Math.max(1, visibleItems - 1);
      track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', function() { scrollCarousel(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { scrollCarousel(1); });

    track.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  });
})();
</script>

{% schema %}
{
  "name": "Collections List",
  "tag": "section",
  "class": "arc-section-collections-list",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Browse Our Shelves"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated shelves for every reader. From Romantasy to Dark Romance, find your next story."
    },
    {
      "type": "range",
      "id": "products_per_carousel",
      "label": "Products per carousel",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "info": "Only the first N products are shown. Users click 'See all' to view the full collection."
    }
  ],
  "blocks": [
    {
      "type": "collection_row",
      "name": "Collection row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Optional — overrides collection title"
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Custom description",
          "info": "Optional — overrides collection description"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button text",
          "default": "See all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections List",
      "blocks": [
        { "type": "collection_row" },
        { "type": "collection_row" },
        { "type": "collection_row" },
        { "type": "collection_row" }
      ]
    }
  ]
}
{% endschema %}
