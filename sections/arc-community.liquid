{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Community Section
  Section: arc-community
  ════════════════════════════════════════════════
  Gradient-background community banner. Eyebrow,
  heading, text, optional feature pills, and a
  button. Light text on a plum/wine gradient.
  ════════════════════════════════════════════════
{%- endcomment -%}

<section
  class="arc-comm arc-comm--{{ section.settings.gradient }} arc-comm--{{ section.settings.height }} arc-comm--{{ section.settings.text_align }}"
  data-section-id="{{ section.id }}">

  <div class="arc-comm__glow" aria-hidden="true"></div>

  <div class="arc-comm__inner">
    <div class="arc-comm__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="arc-comm__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="arc-comm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="arc-comm__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="arc-comm__pills">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pill' and block.settings.label != blank -%}
              <span class="arc-comm__pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="arc-comm__btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} { padding:0 !important; margin:0 !important; }

  .arc-comm {
    --c-plum: #55294A;
    --c-navy: #273046;
    --c-ink: #371D2B;
    --c-gold: #DDC29F;
    --c-cream: #F1E1DD;
    --c-lavender: #B2AABB;
    position:relative;
    width:100%;
    display:flex;
    align-items:center;
    overflow:hidden;
    isolation:isolate;
  }

  /* ── Gradient options ── */
  .arc-comm--plum-wine { background:linear-gradient(135deg, #55294A 0%, #4D3239 100%); }
  .arc-comm--wine-plum { background:linear-gradient(135deg, #4D3239 0%, #55294A 100%); }
  .arc-comm--plum-navy { background:linear-gradient(135deg, #273046 0%, #371D2B 55%, #55294A 100%); }
  .arc-comm--ink-plum  { background:linear-gradient(160deg, #151D2C 0%, #371D2B 55%, #55294A 100%); }

  /* Soft gold + depth glows layered underneath */
  .arc-comm__glow {
    position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:
      radial-gradient(60% 60% at 82% 18%, rgba(221, 194, 159, 0.16) 0%, transparent 60%),
      radial-gradient(70% 70% at 12% 88%, rgba(55, 29, 43, 0.5) 0%, transparent 60%);
  }

  .arc-comm--small  { min-height:340px; }
  .arc-comm--medium { min-height:440px; }
  .arc-comm--large  { min-height:560px; }

  .arc-comm__inner {
    width:100%;max-width:1000px;margin:0 auto;
    padding:72px 40px;box-sizing:border-box;
  }
  .arc-comm__content { max-width:680px; }
  .arc-comm--center .arc-comm__inner { display:flex;justify-content:center; }
  .arc-comm--center .arc-comm__content { max-width:720px;text-align:center;margin:0 auto; }

  .arc-comm__eyebrow {
    font-family:var(--font-body);
    font-size:13.8px;letter-spacing:0.26em;text-transform:uppercase;
    color:var(--c-gold);margin-bottom:20px;
  }
  .arc-comm__heading {
    font-family:var(--font-heading);
    font-size:clamp(34.5px, 5.75vw, 59.8px);line-height:1.08;
    color:var(--c-cream);margin:0 0 20px;font-weight:500;letter-spacing:0.005em;
    text-shadow:0 2px 22px rgba(21, 29, 44, 0.3);
  }
  .arc-comm__text {
    font-family:var(--font-body);
    font-size:clamp(18.4px, 1.725vw, 21.85px);line-height:1.7;
    color:rgba(241, 225, 221, 0.9);margin-bottom:28px;
  }
  .arc-comm__text p { margin:0 0 10px; }
  .arc-comm__text p:last-child { margin-bottom:0; }

  /* ── Feature pills ── */
  .arc-comm__pills {
    display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px;
  }
  .arc-comm--center .arc-comm__pills { justify-content:center; }
  .arc-comm__pill {
    display:inline-block;
    font-family:var(--font-body);
    font-size:16.1px;letter-spacing:0.02em;
    color:var(--c-cream);
    padding:7px 16px;border-radius:999px;
    border:1px solid rgba(221, 194, 159, 0.5);
    background:rgba(221, 194, 159, 0.08);
  }

  .arc-comm__btn {
    display:inline-flex;align-items:center;justify-content:center;
    font-family:var(--font-body);
    font-size:14.95px;letter-spacing:0.16em;text-transform:uppercase;
    padding:16px 38px;border-radius:4px;text-decoration:none;
    background:var(--btn-primary-bg);color:var(--btn-primary-text);border:1.5px solid var(--btn-primary-border);
    transition:all .28s cubic-bezier(.4,0,.2,1);cursor:pointer;
  }
  .arc-comm__btn:hover {
    background:var(--btn-primary-hover-bg);border-color:var(--btn-primary-hover-bg);
    transform:translateY(-2px);box-shadow:0 10px 28px rgba(55, 29, 43, 0.4);
  }

  @media (max-width:768px) {
    .arc-comm__inner { padding:52px 22px; }
    .arc-comm__content,
    .arc-comm--center .arc-comm__content { max-width:100%;text-align:center;margin:0 auto; }
    .arc-comm--center .arc-comm__inner { justify-content:center; }
    .arc-comm__pills { justify-content:center; }
    .arc-comm__btn { width:100%; }
  }
</style>

{% schema %}
{
  "name": "Community",
  "tag": "section",
  "class": "arc-section-community",
  "settings": [
    { "type": "select", "id": "gradient", "label": "Background gradient", "options": [
      { "value": "plum-wine", "label": "Plum → Burgundy" },
      { "value": "wine-plum", "label": "Burgundy → Plum" },
      { "value": "plum-navy", "label": "Navy → Plum" },
      { "value": "ink-plum", "label": "Deep navy → Plum" }
    ], "default": "plum-wine" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Court" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Than a Bookshop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A Romance Court is a community for romance readers. Join book clubs, events, reading challenges, Houses and hundreds of readers who speak your language.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Court" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height", "label": "Height", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" }
    ], "default": "medium" },
    { "type": "select", "id": "text_align", "label": "Content alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Feature pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Book Clubs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community",
      "blocks": [
        { "type": "pill", "settings": { "label": "Book Clubs" } },
        { "type": "pill", "settings": { "label": "Events" } },
        { "type": "pill", "settings": { "label": "Reading Challenges" } },
        { "type": "pill", "settings": { "label": "The Houses" } }
      ]
    }
  ]
}
{% endschema %}