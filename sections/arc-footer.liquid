{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Footer
  Section: arc-footer
  ════════════════════════════════════════════════
  4-column slim: Brand, Shop, Community, Visit.
  Newsletter bar. Rising particles
  SVG motifs. House dots in bottom bar.
  ════════════════════════════════════════════════
{%- endcomment -%}

<footer class="arc-footer" data-section-id="{{ section.id }}">

  {%- comment -%} ── Particles ── {%- endcomment -%}
  <div class="arc-footer__particles">
    {%- for i in (1..15) -%}
      <div class="arc-fp arc-fp--drift arc-fp--d{{ i }}"></div>
    {%- endfor -%}
    {%- for i in (1..10) -%}
      <div class="arc-fp arc-fp--twinkle arc-fp--t{{ i }}"></div>
    {%- endfor -%}
    {%- for i in (1..10) -%}
      <div class="arc-fp arc-fp--motif arc-fp--m{{ i }}">
        <svg class="arc-fp__svg" viewBox="0 0 24 24"><path class="arc-motif-path" d="M12 2L13.5 8.5L20 7L15 12L20 17L13.5 15.5L12 22L10.5 15.5L4 17L9 12L4 7L10.5 8.5L12 2Z"/></svg>
      </div>
    {%- endfor -%}
  </div>

  <div class="arc-footer__inner">

    {%- comment -%} ── 4-Column Grid ── {%- endcomment -%}
    <div class="arc-footer__grid">

      {%- comment -%} Col 1: Brand {%- endcomment -%}
      <div>
        <a class="arc-footer__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              width="200"
              height="auto"
              loading="lazy"
            >
          {%- else -%}
            <span class="arc-footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <div class="arc-footer__tagline">{{ section.settings.tagline }}</div>
        <div class="arc-footer__social">
          {%- if section.settings.social_instagram != blank -%}
            <a class="arc-footer__social-link" href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a class="arc-footer__social-link" href="{{ section.settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_email != blank -%}
            <a class="arc-footer__social-link" href="mailto:{{ section.settings.social_email }}" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Col 2: Shop {%- endcomment -%}
      <div>
        <div class="arc-footer__col-title">Shop</div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'shop_link' -%}
            <a class="arc-footer__link" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Col 3: Community {%- endcomment -%}
      <div>
        <div class="arc-footer__col-title">Community</div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'community_link' -%}
            <a class="arc-footer__link" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Col 4: Visit {%- endcomment -%}
      <div>
        <div class="arc-footer__col-title">Visit Us</div>
        <div class="arc-footer__address">{{ section.settings.address }}</div>
        <div class="arc-footer__hours">{{ section.settings.hours }}</div>
        {%- if section.settings.directions_url != blank -%}
          <a class="arc-footer__directions" href="{{ section.settings.directions_url }}" target="_blank" rel="noopener">
            Get directions <span class="arc-footer__dir-arrow">&rarr;</span>
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} ── Newsletter ── {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="arc-footer__newsletter">
        <div class="arc-footer__newsletter-text">
          <div class="arc-footer__newsletter-title">{{ section.settings.newsletter_title | default: 'Join the Court' }}</div>
          <div class="arc-footer__newsletter-desc">{{ section.settings.newsletter_desc | default: 'New arrivals, events, and community news.' }}</div>
        </div>
        {%- form 'customer', id: 'arc-footer-newsletter' -%}
          <div class="arc-footer__newsletter-form">
            <input
              class="arc-footer__newsletter-input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'your@email.com' }}"
              required
              autocomplete="email"
            >
            <button class="arc-footer__newsletter-btn" type="submit">
              {{ section.settings.newsletter_button | default: 'Subscribe' }}
            </button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Bottom Bar ── {%- endcomment -%}
    <div class="arc-footer__bottom">
      <div class="arc-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
      <div class="arc-footer__houses">
        <div class="arc-footer__house-dot" style="background:var(--house-emerald)" title="Emerald Willow"></div>
        <div class="arc-footer__house-dot" style="background:var(--house-onyx)" title="Onyx Raven"></div>
        <div class="arc-footer__house-dot" style="background:var(--house-sapphire)" title="Midnight Sapphire"></div>
        <div class="arc-footer__house-dot" style="background:var(--house-ruby)" title="Blood Ruby"></div>
      </div>
      <div class="arc-footer__legal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'legal_link' -%}
            <a class="arc-footer__legal-link" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

{% stylesheet %}
  /* ══════════════════════════════════════════
     ARC FOOTER
     ══════════════════════════════════════════ */

  /* ── Rising particle animations ── */
  @keyframes rise-1{0%{transform:translateY(0) translateX(0);opacity:0}8%{opacity:0.6}88%{opacity:0.6}100%{transform:translateY(-280px) translateX(20px);opacity:0}}
  @keyframes rise-2{0%{transform:translateY(0) translateX(0);opacity:0}10%{opacity:0.45}85%{opacity:0.45}100%{transform:translateY(-260px) translateX(-15px);opacity:0}}
  @keyframes rise-3{0%{transform:translateY(0) translateX(0);opacity:0}6%{opacity:0.55}90%{opacity:0.55}100%{transform:translateY(-300px) translateX(12px);opacity:0}}
  @keyframes rise-motif-1{0%{transform:translateY(0) translateX(0) rotate(0deg);opacity:0}8%{opacity:1}85%{opacity:1}100%{transform:translateY(-300px) translateX(35px) rotate(90deg);opacity:0}}
  @keyframes rise-motif-2{0%{transform:translateY(0) translateX(0) rotate(0deg);opacity:0}10%{opacity:1}88%{opacity:1}100%{transform:translateY(-280px) translateX(-25px) rotate(-120deg);opacity:0}}
  @keyframes rise-motif-3{0%{transform:translateY(0) translateX(0) rotate(0deg);opacity:0}6%{opacity:1}92%{opacity:1}100%{transform:translateY(-320px) translateX(18px) rotate(180deg);opacity:0}}
  @keyframes fp-twinkle{0%,100%{opacity:0.1}50%{opacity:0.45}}

  .arc-footer__particles{position:absolute;top:0;left:0;right:0;bottom:0;overflow:hidden;pointer-events:none;z-index:0}
  .arc-fp{position:absolute;border-radius:50%}

  /* Drifting dots */
  .arc-fp--drift{width:3px;height:3px}
  .arc-fp--d1{left:4%;bottom:2%;background:var(--accent-glow);animation:rise-1 9s ease-in-out infinite}
  .arc-fp--d2{left:11%;bottom:8%;background:var(--text-muted-on-dark);animation:rise-2 11s ease-in-out infinite 1.2s}
  .arc-fp--d3{left:18%;bottom:4%;background:var(--accent-glow);animation:rise-3 10s ease-in-out infinite 2.8s}
  .arc-fp--d4{left:26%;bottom:12%;background:var(--accent-glow);animation:rise-1 12s ease-in-out infinite 0.6s}
  .arc-fp--d5{left:33%;bottom:6%;background:var(--text-muted-on-dark);animation:rise-2 8.5s ease-in-out infinite 3.5s}
  .arc-fp--d6{left:40%;bottom:3%;background:var(--accent-glow);animation:rise-3 11.5s ease-in-out infinite 1.8s}
  .arc-fp--d7{left:48%;bottom:10%;background:var(--accent-glow);animation:rise-1 10.5s ease-in-out infinite 4.2s}
  .arc-fp--d8{left:55%;bottom:5%;background:var(--text-muted-on-dark);animation:rise-2 9.5s ease-in-out infinite 0.4s}
  .arc-fp--d9{left:63%;bottom:8%;background:var(--accent-glow);animation:rise-3 13s ease-in-out infinite 2.2s}
  .arc-fp--d10{left:70%;bottom:2%;background:var(--accent-glow);animation:rise-1 10s ease-in-out infinite 5s}
  .arc-fp--d11{left:77%;bottom:14%;background:var(--text-muted-on-dark);animation:rise-2 8s ease-in-out infinite 1.5s}
  .arc-fp--d12{left:84%;bottom:6%;background:var(--accent-glow);animation:rise-3 12.5s ease-in-out infinite 3.8s}
  .arc-fp--d13{left:91%;bottom:4%;background:var(--accent-glow);animation:rise-1 9.5s ease-in-out infinite 2.5s}
  .arc-fp--d14{left:22%;bottom:16%;background:var(--text-muted-on-dark);animation:rise-2 14s ease-in-out infinite 6s}
  .arc-fp--d15{left:58%;bottom:18%;background:var(--accent-glow);animation:rise-3 13.5s ease-in-out infinite 4.8s}

  /* Twinkling */
  .arc-fp--twinkle{width:2px;height:2px;background:var(--accent-glow)}
  .arc-fp--t1{left:6%;top:20%;animation:fp-twinkle 4s ease-in-out infinite}
  .arc-fp--t2{left:17%;top:50%;animation:fp-twinkle 5.2s ease-in-out infinite 1.1s}
  .arc-fp--t3{left:30%;top:15%;animation:fp-twinkle 3.8s ease-in-out infinite 2.4s}
  .arc-fp--t4{left:45%;top:60%;animation:fp-twinkle 6s ease-in-out infinite 0.7s}
  .arc-fp--t5{left:58%;top:28%;animation:fp-twinkle 4.5s ease-in-out infinite 3.3s}
  .arc-fp--t6{left:70%;top:45%;animation:fp-twinkle 5.5s ease-in-out infinite 1.6s}
  .arc-fp--t7{left:82%;top:12%;animation:fp-twinkle 3.5s ease-in-out infinite 4.2s}
  .arc-fp--t8{left:93%;top:55%;animation:fp-twinkle 4.8s ease-in-out infinite 2.8s}
  .arc-fp--t9{left:38%;top:75%;animation:fp-twinkle 5.8s ease-in-out infinite 0.3s}
  .arc-fp--t10{left:75%;top:70%;animation:fp-twinkle 6.2s ease-in-out infinite 3.9s}

  /* Motifs */
  .arc-fp--motif{border-radius:0;width:14px;height:14px}
  .arc-fp__svg{width:100%;height:100%;fill:none;stroke:var(--motif);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .arc-fp--m1{left:7%;bottom:3%;animation:rise-motif-1 14s ease-in-out infinite 0.5s}
  .arc-fp--m2{left:15%;bottom:7%;animation:rise-motif-2 16s ease-in-out infinite 3s}
  .arc-fp--m3{left:25%;bottom:1%;animation:rise-motif-3 13s ease-in-out infinite 5.5s}
  .arc-fp--m4{left:37%;bottom:5%;animation:rise-motif-1 15s ease-in-out infinite 1.5s}
  .arc-fp--m5{left:50%;bottom:9%;animation:rise-motif-2 12.5s ease-in-out infinite 4s}
  .arc-fp--m6{left:62%;bottom:2%;animation:rise-motif-3 17s ease-in-out infinite 2s}
  .arc-fp--m7{left:73%;bottom:6%;animation:rise-motif-1 14.5s ease-in-out infinite 6.5s}
  .arc-fp--m8{left:85%;bottom:4%;animation:rise-motif-2 13.5s ease-in-out infinite 3.5s}
  .arc-fp--m9{left:43%;bottom:12%;animation:rise-motif-3 16.5s ease-in-out infinite 7s}
  .arc-fp--m10{left:95%;bottom:8%;animation:rise-motif-1 15.5s ease-in-out infinite 5s}

  /* ── Footer layout ── */
  .arc-footer{background:var(--bg-dark);position:relative;overflow:hidden}
  .arc-footer::before{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,var(--accent-primary),transparent);z-index:1}
  .arc-footer__inner{max-width:1100px;margin:0 auto;padding:52px 40px 28px;position:relative;z-index:1}

  .arc-footer__grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.3fr;gap:36px;margin-bottom:32px}

  /* Brand */
  .arc-footer__logo{display:inline-block;margin-bottom:12px;text-decoration:none}
  .arc-footer__logo img{height:48px;width:auto;display:block}
  .arc-footer__logo-text{font-family:var(--font-heading);font-size:23px;color:var(--text-on-dark)}
  .arc-footer__tagline{font-family:var(--font-body);font-size:18.4px;color:var(--text-muted-on-dark);line-height:1.65;margin-bottom:18px}
  .arc-footer__social{display:flex;gap:10px}
  .arc-footer__social-link{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-md, 8px);border:1px solid rgba(241, 225, 221, 0.08);color:var(--text-muted-on-dark);transition:all 0.25s cubic-bezier(0.4,0,0.2,1);text-decoration:none}
  .arc-footer__social-link:hover{border-color:var(--accent-primary);color:var(--accent-primary);background:rgba(221, 194, 159, 0.06)}
  .arc-footer__social-link svg{width:16px;height:16px}

  /* Link columns */
  .arc-footer__col-title{font-family:var(--font-body);font-size:13.8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-primary);margin-bottom:14px}
  .arc-footer__link{display:block;font-family:var(--font-body);font-size:18.4px;color:var(--text-muted-on-dark);text-decoration:none;padding:4px 0;transition:color 0.2s}
  .arc-footer__link:hover{color:var(--text-on-dark)}

  /* Visit */
  .arc-footer__address{font-family:var(--font-body);font-size:18.4px;color:var(--text-muted-on-dark);line-height:1.65;margin-bottom:12px}
  .arc-footer__hours{font-family:var(--font-body);font-size:16.1px;color:rgba(241, 225, 221, 0.35);line-height:1.6;margin-bottom:14px}
  .arc-footer__directions{font-family:var(--font-body);font-size:16.1px;color:var(--accent-primary);text-decoration:none;transition:color 0.2s;display:inline-flex;align-items:center;gap:6px}
  .arc-footer__directions:hover{color:var(--accent-glow)}
  .arc-footer__dir-arrow{display:inline-block;transition:transform 0.3s cubic-bezier(0.4,0,0.2,1)}
  .arc-footer__directions:hover .arc-footer__dir-arrow{transform:translateX(4px)}

  /* Newsletter */
  .arc-footer__newsletter{border-top:1px solid rgba(241, 225, 221, 0.06);padding:28px 0;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .arc-footer__newsletter-title{font-family:var(--font-heading);font-size:23px;color:var(--text-on-dark);margin-bottom:2px}
  .arc-footer__newsletter-desc{font-size:16.1px;color:var(--text-muted-on-dark)}
  .arc-footer__newsletter-form{display:flex;gap:8px;flex:1;max-width:380px}
  .arc-footer__newsletter-input{flex:1;padding:11px 14px;border-radius:var(--radius-md, 8px);border:1px solid rgba(241, 225, 221, 0.08);background:rgba(241, 225, 221, 0.03);color:var(--text-on-dark);font-family:var(--font-body);font-size:18.4px;outline:none;transition:border-color 0.25s}
  .arc-footer__newsletter-input::placeholder{color:rgba(241, 225, 221, 0.25)}
  .arc-footer__newsletter-input:focus{border-color:var(--accent-primary)}
  .arc-footer__newsletter-btn{padding:11px 20px;border-radius:var(--radius-md, 8px);border:1px solid var(--accent-primary);background:var(--accent-primary);color:var(--bg-dark);font-family:var(--font-body);font-size:18.4px;cursor:pointer;transition:all 0.25s cubic-bezier(0.4,0,0.2,1);position:relative;overflow:hidden;white-space:nowrap}
  .arc-footer__newsletter-btn::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(241, 225, 221, .15),transparent);transition:left .5s cubic-bezier(0.4,0,0.2,1);pointer-events:none}
  .arc-footer__newsletter-btn:hover::before{left:100%}

  /* Bottom */
  .arc-footer__bottom{border-top:1px solid rgba(241, 225, 221, 0.05);padding-top:20px;display:flex;align-items:center;justify-content:space-between}
  .arc-footer__copyright{font-size:13.8px;color:rgba(241, 225, 221, 0.2)}
  .arc-footer__houses{display:flex;gap:8px}
  .arc-footer__house-dot{width:8px;height:8px;border-radius:50%;opacity:0.4;transition:all 0.3s cubic-bezier(0.4,0,0.2,1)}
  .arc-footer__house-dot:hover{opacity:1;transform:scale(1.4)}
  .arc-footer__legal{display:flex;gap:16px}
  .arc-footer__legal-link{font-size:13.8px;color:rgba(241, 225, 221, 0.2);text-decoration:none;transition:color 0.2s}
  .arc-footer__legal-link:hover{color:rgba(241, 225, 221, 0.4)}

  @media(max-width:768px){
    .arc-footer__grid{grid-template-columns:1fr 1fr;gap:28px 24px}
    .arc-footer__grid>div:first-child{grid-column:1/-1}
    .arc-footer__inner{padding:40px 20px 24px}
    .arc-footer__newsletter{flex-direction:column;align-items:flex-start}
    .arc-footer__newsletter-form{max-width:100%;width:100%}
    .arc-footer__bottom{flex-direction:column;gap:12px}
  }
  @media(prefers-reduced-motion:reduce){
    .arc-fp{animation:none!important;opacity:0.15!important}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "arc-section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (light version for dark bg)",
      "info": "Light-colored logo for the dark footer"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Romance & Fantasy bookstore in Gràcia, Barcelona. Books, community, and a Court of readers."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "social_email",
      "label": "Email address",
      "default": "info@aromancecourt.com"
    },
    {
      "type": "header",
      "content": "Visit"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Carrer Monistrol, 1\nGràcia · Barcelona"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Opening hours",
      "default": "Tue — Sat: 11:00 — 20:00\nSun — Mon: Closed"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions URL",
      "info": "Google Maps link"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Title",
      "default": "Join the Court"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Description",
      "default": "New arrivals, events, and community news."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button text",
      "default": "Subscribe"
    }
  ],
  "blocks": [
    {
      "type": "shop_link",
      "name": "Shop link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All Books" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    },
    {
      "type": "community_link",
      "name": "Community link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Houses" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    },
    {
      "type": "legal_link",
      "name": "Legal link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Privacy" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "shop_link", "settings": { "label": "All Books" } },
        { "type": "shop_link", "settings": { "label": "Preorders" } },
        { "type": "shop_link", "settings": { "label": "Book Boxes" } },
        { "type": "shop_link", "settings": { "label": "Blind Dates" } },
        { "type": "community_link", "settings": { "label": "The Houses" } },
        { "type": "community_link", "settings": { "label": "Events" } },
        { "type": "community_link", "settings": { "label": "Membership" } },
        { "type": "legal_link", "settings": { "label": "Privacy" } },
        { "type": "legal_link", "settings": { "label": "Terms" } },
        { "type": "legal_link", "settings": { "label": "Shipping" } },
        { "type": "legal_link", "settings": { "label": "Returns" } }
      ]
    }
  ]
}
{% endschema %}
