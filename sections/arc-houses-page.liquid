<script>
  /* Scroll reveal */
  (function() {
    var reveals = document.querySelectorAll('.arc-reveal');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('arc-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    reveals.forEach(function(el) { observer.observe(el); });
  })();

  /* Button glitch init */
  (function() {
    function initButtons() {
      document.querySelectorAll('.arc-btn-primary, .arc-btn-ghost').forEach(function(btn) {
        var text = btn.textContent.replace(/\s+/g, ' ').trim();
        if (text && !btn.getAttribute('data-text')) btn.setAttribute('data-text', text);
      });
    }
    initButtons();
    document.addEventListener('shopify:section:load', initButtons);
  })();

  /* House standings — auto-sort + bar animation */
  (function() {
    var board = document.getElementById('arc-scoreboard');
    if (!board) return;
    var cols = Array.from(board.querySelectorAll('.arc-score-col'));
    var ORDINALS = ['I', 'II', 'III', 'IV'];

    cols.forEach(function(col) {
      var pts = parseInt(col.dataset.pts, 10);
      if (!pts || isNaN(pts)) {
        var numEl = col.querySelector('.arc-score-num');
        pts = numEl ? parseInt(numEl.textContent.trim(), 10) || 0 : 0;
        col.dataset.pts = pts;
      }
    });

    cols.sort(function(a, b) { return parseInt(b.dataset.pts, 10) - parseInt(a.dataset.pts, 10); });
    var maxPts = parseInt(cols[0].dataset.pts, 10) || 1;

    cols.forEach(function(col, i) {
      board.appendChild(col);
      col.setAttribute('data-order', i + 1);
      var rankEl = col.querySelector('.arc-rank-num');
      if (rankEl) rankEl.textContent = ORDINALS[i];
      var pct = Math.round((parseInt(col.dataset.pts, 10) / maxPts) * 100);
      var fill = col.querySelector('.arc-score-bar-fill');
      if (fill) fill._targetH = pct + '%';
    });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        Array.from(board.querySelectorAll('.arc-score-col')).forEach(function(col, i) {
          var fill = col.querySelector('.arc-score-bar-fill');
          if (!fill) return;
          setTimeout(function() { fill.style.height = fill._targetH || '0%'; }, i * 130);
        });
        observer.disconnect();
      });
    }, { threshold: 0.15 });
    observer.observe(board);
  })();
</script>

