{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Houses Page
  Section: arc-houses-page
  ════════════════════════════════════════════════
  Full houses page: hero, what are the houses,
  four house cards, initiation, membership,
  standings scoreboard, points system, closing.
  
  SETUP:
  1. Upload arc-houses.css to assets/
  2. Upload this to sections/
  3. Create templates/page.houses.json with:
     { "sections": { "main": { "type": "arc-houses-page" } }, "order": ["main"] }
  4. In Shopify admin, create a Page called "The Houses"
     and assign template "houses" to it
  5. Make sure all house logo assets are in assets/
  ════════════════════════════════════════════════
{%- endcomment -%}

{{ 'arc-houses.css' | asset_url | stylesheet_tag }}

<style>
  /* Ultra-high specificity overrides using section ID */
  #shopify-section-{{ section.id }} .arc-houses { font-size: 22px !important; line-height: 1.85 !important; }
  #shopify-section-{{ section.id }} #arc-what p { font-size: 1.8rem !important; line-height: 1.9 !important; }
  #shopify-section-{{ section.id }} .arc-hero-tagline { font-size: clamp(1.6rem, 3vw, 2.2rem) !important; }
  #shopify-section-{{ section.id }} .arc-hero-subtext { font-size: 1.3rem !important; }
  #shopify-section-{{ section.id }} .arc-revelation-block p { font-size: 1.4rem !important; }
  #shopify-section-{{ section.id }} .arc-house-name { font-size: clamp(1.6rem, 3vw, 2rem) !important; }
  #shopify-section-{{ section.id }} .arc-house-motto { font-size: 1.6rem !important; }
  #shopify-section-{{ section.id }} .arc-house-desc { font-size: 1.5rem !important; line-height: 1.8 !important; }
  #shopify-section-{{ section.id }} .arc-house-traits { font-size: 0.85rem !important; }
  #shopify-section-{{ section.id }} .arc-init-block p { font-size: 1.6rem !important; line-height: 1.9 !important; }
  #shopify-section-{{ section.id }} .arc-init-block h3 { font-size: 1.4rem !important; }
  #shopify-section-{{ section.id }} .arc-membership-text p { font-size: 1.5rem !important; }
  #shopify-section-{{ section.id }} .arc-membership-list li { font-size: 1.5rem !important; }
  #shopify-section-{{ section.id }} .arc-standings-note { font-size: 1.2rem !important; }
  #shopify-section-{{ section.id }} .arc-points-intro { font-size: 1.5rem !important; }
  #shopify-section-{{ section.id }} .arc-points-desc { font-size: 1.2rem !important; }
  #shopify-section-{{ section.id }} .arc-points-row-body h4 { font-size: 1.1rem !important; }
  #shopify-section-{{ section.id }} .arc-points-value { font-size: 1.2rem !important; }
  #shopify-section-{{ section.id }} .arc-points-footer p { font-size: 1.5rem !important; }
  #shopify-section-{{ section.id }} .arc-closing-verse p { font-size: clamp(1.6rem, 3vw, 2.2rem) !important; }
  #shopify-section-{{ section.id }} .arc-season-note { font-size: 1.2rem !important; }
  #shopify-section-{{ section.id }} .arc-eyebrow { font-size: 1.1rem !important; letter-spacing: 0.35em !important; }
  #shopify-section-{{ section.id }} .arc-btn-primary,
  #shopify-section-{{ section.id }} .arc-btn-ghost { font-size: 1rem !important; }
  #shopify-section-{{ section.id }} .arc-score-name { font-size: 0.9rem !important; }
  #shopify-section-{{ section.id }} .arc-bname { font-size: 0.85rem !important; }
  
  /* Fix: Dawn's base.css hides empty divs — override for score bars */
  #shopify-section-{{ section.id }} .arc-score-bar-fill { display: block !important; }
  #shopify-section-{{ section.id }} .arc-score-bar-track { display: flex !important; }
  #shopify-section-{{ section.id }} .arc-score-bar-container { display: block !important; }
</style>

