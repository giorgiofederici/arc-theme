{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Small Image Banner
  Section: arc-image-banner
  ════════════════════════════════════════════════
  Compact promo banner. Background can be a solid
  wine fill, a solid plum fill, or an uploaded
  image (with a wine overlay for legibility).
  Title, text, single button.
  ════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign bg = section.settings.background_type
  assign use_image = false
  if bg == 'image' and section.settings.bg_image != blank
    assign use_image = true
  endif
-%}

<section
  class="arc-banner arc-banner--{{ section.settings.height }} arc-banner--{{ section.settings.text_align }} arc-banner--bg-{{ bg }}"
  data-section-id="{{ section.id }}">

  {%- if use_image -%}
    <img class="arc-banner__bg"
         src="{{ section.settings.bg_image | image_url: width: 2000 }}"
         srcset="{{ section.settings.bg_image | image_url: width: 800 }} 800w,
                 {{ section.settings.bg_image | image_url: width: 1400 }} 1400w,
                 {{ section.settings.bg_image | image_url: width: 2000 }} 2000w"
         sizes="100vw"
         alt="{{ section.settings.heading | escape }}"
         loading="lazy">
    <div class="arc-banner__overlay" style="opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  {%- endif -%}

  <div class="arc-banner__inner">
    <div class="arc-banner__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="arc-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="arc-banner__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="arc-banner__btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} { padding:0 !important; margin:0 !important; }

  .arc-banner {
    --banner-wine: #55294A;
    --banner-wine-hover: #55294A;
    --banner-plum: #55294A;
    --banner-gold: #DDC29F;
    --banner-cream: #F1E1DD;
    --banner-ink: #371D2B;
    position:relative;
    width:100%;
    display:flex;
    align-items:center;
    overflow:hidden;
    isolation:isolate;
  }
  .arc-banner--bg-wine { background:var(--banner-wine); }
  .arc-banner--bg-plum { background:var(--banner-plum); }
  .arc-banner--bg-image { background:var(--banner-wine); }

  .arc-banner--small  { min-height:280px; }
  .arc-banner--medium { min-height:360px; }
  .arc-banner--tall   { min-height:460px; }

  .arc-banner__bg {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    z-index:-2;
  }
  .arc-banner__overlay {
    position:absolute;
    inset:0;
    z-index:-1;
    background:linear-gradient(90deg, rgba(55, 29, 43, 0.85) 0%, rgba(55, 29, 43, 0.55) 55%, rgba(55, 29, 43, 0.35) 100%);
  }
  .arc-banner--center .arc-banner__overlay {
    background:linear-gradient(0deg, rgba(55, 29, 43, 0.7) 0%, rgba(55, 29, 43, 0.45) 100%);
  }

  .arc-banner__inner {
    width:100%;
    max-width:1240px;
    margin:0 auto;
    padding:52px 40px;
    box-sizing:border-box;
  }
  .arc-banner__content { max-width:640px; }
  .arc-banner--center .arc-banner__inner { display:flex;justify-content:center; }
  .arc-banner--center .arc-banner__content { max-width:640px;text-align:center;margin:0 auto; }

  .arc-banner__heading {
    font-family:var(--font-heading);
    font-size:clamp(32.2px, 4.6vw, 48.3px);
    line-height:1.1;
    color:var(--banner-cream);
    margin:0 0 14px;
    font-weight:500;
    letter-spacing:0.005em;
  }
  .arc-banner__text {
    font-family:var(--font-body);
    font-size:clamp(17.25px, 1.61vw, 20.7px);
    line-height:1.65;
    color:rgba(241, 225, 221, 0.88);
    margin-bottom:26px;
  }
  .arc-banner__text p { margin:0 0 8px; }
  .arc-banner__text p:last-child { margin-bottom:0; }

  .arc-banner__btn {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-family:var(--font-body);
    font-size:14.95px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    padding:15px 34px;
    border-radius:4px;
    text-decoration:none;
    background:var(--banner-gold);
    color:var(--banner-ink);
    border:1.5px solid var(--banner-gold);
    transition:all .25s cubic-bezier(.4,0,.2,1);
    cursor:pointer;
  }
  .arc-banner__btn:hover {
    background:var(--banner-cream);
    border-color:var(--banner-cream);
    transform:translateY(-2px);
    box-shadow:0 10px 26px rgba(55, 29, 43, 0.35);
  }

  @media (max-width:768px) {
    .arc-banner__inner { padding:40px 20px; }
    .arc-banner__overlay,
    .arc-banner--center .arc-banner__overlay {
      background:linear-gradient(0deg, rgba(55, 29, 43, 0.82) 0%, rgba(55, 29, 43, 0.6) 100%);
    }
    .arc-banner__content,
    .arc-banner--center .arc-banner__content { max-width:100%;text-align:left; }
    .arc-banner--center .arc-banner__inner { justify-content:flex-start; }
    .arc-banner__btn { width:100%; }
  }
</style>

{% schema %}
{
  "name": "Small Image Banner",
  "tag": "section",
  "class": "arc-section-image-banner",
  "settings": [
    { "type": "select", "id": "background_type", "label": "Background", "options": [
      { "value": "wine", "label": "Wine (solid)" },
      { "value": "plum", "label": "Plum (solid)" },
      { "value": "image", "label": "Image" }
    ], "default": "wine" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Used only when Background is set to Image. Landscape, at least 1600px wide." },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70, "info": "Darkens the image so text stays readable." },
    { "type": "text", "id": "heading", "label": "Title", "default": "Going Away?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Don't waste your holiday looking for bookshops. We'll send your books wherever you're staying in Spain so your next read is waiting for you.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send Me Books" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height", "label": "Height", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "tall", "label": "Tall" }
    ], "default": "small" },
    { "type": "select", "id": "text_align", "label": "Content alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" }
  ],
  "presets": [{ "name": "Small Image Banner" }]
}
{% endschema %}