{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Multicolumn
  Section: arc-multicolumn
  ════════════════════════════════════════════════
  Events, community features, or any
  multi-card info layout.
  ════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign bg_style = section.settings.bg_style | default: 'dark'
  assign columns = section.blocks.size | at_most: 4
  if columns < 2
    assign columns = 3
  endif
-%}

<div
  class="arc-mc{% if bg_style == 'dark' %} arc-mc--dark{% elsif bg_style == 'surface' %} arc-mc--surface{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="arc-mc__inner">

    {%- if section.settings.overline != blank or section.settings.heading != blank -%}
      <div class="arc-mc__header">
        {%- if section.settings.overline != blank -%}
          <div class="arc-mc__overline">{{ section.settings.overline }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="arc-mc__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="arc-mc__desc">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="arc-mc__grid arc-mc__grid--{{ columns }}">
      {%- for block in section.blocks -%}
        <div class="arc-mc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="arc-mc__card-img-wrap">
              <img
                class="arc-mc__card-img"
                src="{{ block.settings.image | image_url: width: 500 }}"
                alt="{{ block.settings.heading | escape }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}
          {%- if block.settings.icon != blank -%}
            <div class="arc-mc__card-icon">{{ block.settings.icon }}</div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="arc-mc__card-title">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="arc-mc__card-text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.cta_text != blank -%}
            <a class="arc-mc__card-cta" href="{{ block.settings.cta_url }}">
              {{ block.settings.cta_text }} <span class="arc-mc__card-arrow">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_cta_text != blank -%}
      <div class="arc-mc__footer">
        <a
          class="arc-btn{% if bg_style == 'dark' %} arc-btn--primary{% else %} arc-btn--secondary{% endif %}"
          href="{{ section.settings.footer_cta_url }}"
        >
          {{ section.settings.footer_cta_text }} <span class="arc-btn__arrow">&rarr;</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .arc-mc { padding: 56px 0; background: var(--bg-primary); }
  .arc-mc--surface { background: var(--bg-surface); }
  .arc-mc--dark { background: var(--bg-dark); }

  .arc-mc__inner { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

  .arc-mc__header { text-align: center; margin-bottom: 36px; }
  .arc-mc__overline { font-family: var(--font-body); font-size: 13.8px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 8px; }
  .arc-mc--dark .arc-mc__overline { color: var(--accent-primary); }
  .arc-mc__title { font-family: var(--font-heading); font-size: clamp(1.84rem, 3.45vw, 2.53rem); color: var(--text-heading); line-height: 1.2; margin: 0 0 8px; font-weight: normal; }
  .arc-mc--dark .arc-mc__title { color: var(--text-on-dark); }
  .arc-mc__desc { font-family: var(--font-body); font-size: 18.4px; color: var(--text-muted); max-width: 520px; margin: 0 auto; line-height: 1.6; }
  .arc-mc--dark .arc-mc__desc { color: var(--text-muted-on-dark); }

  .arc-mc__grid { display: grid; gap: 20px; }
  .arc-mc__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .arc-mc__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .arc-mc__grid--4 { grid-template-columns: repeat(4, 1fr); }

  .arc-mc__card {
    padding: 28px 24px;
    border-radius: 16px;
    text-align: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .arc-mc__card:hover { transform: translateY(-4px); }
  .arc-mc .arc-mc__card { background: var(--bg-elevated); border: 1px solid var(--border-subtle); }
  .arc-mc--surface .arc-mc__card { background: var(--bg-elevated); border: 1px solid var(--border-subtle); }
  .arc-mc--dark .arc-mc__card { background: rgba(241, 225, 221, 0.04); border: 1px solid rgba(241, 225, 221, 0.06); }

  .arc-mc__card-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .arc-mc__card-img {
    width: 100%; height: auto; display: block;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .arc-mc__card:hover .arc-mc__card-img { transform: scale(1.04); }

  .arc-mc__card-icon {
    font-size: 32.2px;
    margin-bottom: 12px;
    line-height: 1;
  }
  .arc-mc__card-title {
    font-family: var(--font-heading);
    font-size: 23px;
    color: var(--text-heading);
    margin: 0 0 8px;
    font-weight: normal;
  }
  .arc-mc--dark .arc-mc__card-title { color: var(--text-on-dark); }
  .arc-mc__card-text {
    font-family: var(--font-body);
    font-size: 16.1px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .arc-mc--dark .arc-mc__card-text { color: var(--text-muted-on-dark); }
  .arc-mc__card-cta {
    font-family: var(--font-body);
    font-size: 16.1px;
    color: var(--accent-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .arc-mc__card-arrow {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .arc-mc__card:hover .arc-mc__card-arrow { transform: translateX(3px); }
  .arc-mc__footer { text-align: center; margin-top: 32px; }

  @media (max-width: 768px) {
    .arc-mc { padding: 40px 0; }
    .arc-mc__inner { padding: 0 20px; }
    .arc-mc__grid--3, .arc-mc__grid--4 { grid-template-columns: 1fr; }
    .arc-mc__card { padding: 24px 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "arc-section-multicolumn",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Events at the Court" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select", "id": "bg_style", "label": "Background",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Surface" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "footer_cta_text", "label": "Footer button text" },
    { "type": "url", "id": "footer_cta_url", "label": "Footer button link" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "icon", "label": "Icon/emoji (optional)", "info": "Shows above heading if no image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta_text", "label": "Link text" },
        { "type": "url", "id": "cta_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "heading": "Book Club", "icon": "📚" } },
        { "type": "column", "settings": { "heading": "Author Signings", "icon": "✍️" } },
        { "type": "column", "settings": { "heading": "Special Events", "icon": "🏰" } }
      ]
    }
  ]
}
{% endschema %}
