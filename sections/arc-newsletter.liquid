{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Newsletter Signup
  Section: arc-newsletter
  ════════════════════════════════════════════════
  Minimal dark newsletter section. Can be placed
  anywhere — above footer or standalone.
  ════════════════════════════════════════════════
{%- endcomment -%}

<div class="arc-nl" data-section-id="{{ section.id }}">
  <div class="arc-nl__inner">
    {%- if section.settings.overline != blank -%}
      <div class="arc-nl__overline">{{ section.settings.overline }}</div>
    {%- endif -%}
    <h2 class="arc-nl__title">{{ section.settings.heading | default: 'Stay close to the Court' }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="arc-nl__desc">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: 'arc-newsletter-section' -%}
      <div class="arc-nl__form">
        <input
          class="arc-nl__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
          required
          autocomplete="email"
        >
        <button class="arc-nl__btn" type="submit">
          {{ section.settings.button_text | default: 'Subscribe' }}
        </button>
      </div>
    {%- endform -%}

    {%- if section.settings.note != blank -%}
      <div class="arc-nl__note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  @keyframes arc-buzz {
    0%,100%{transform:translateX(0)}10%{transform:translateX(-1.5px)}20%{transform:translateX(1.5px)}30%{transform:translateX(-1px)}40%{transform:translateX(1px)}50%{transform:translateX(-0.5px)}60%{transform:translateX(0)}
  }

  .arc-nl {
    background: var(--bg-dark);
    padding: 56px 0;
    text-align: center;
    position: relative;
  }
  .arc-nl::before {
    content: '';
    position: absolute;
    top: 0; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
  }
  .arc-nl__inner {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .arc-nl__overline {
    font-family: var(--font-body);
    font-size: 13.8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 10px;
  }
  .arc-nl__title {
    font-family: var(--font-heading);
    font-size: clamp(1.725rem, 3.45vw, 2.3rem);
    color: var(--text-on-dark);
    margin: 0 0 8px;
    font-weight: normal;
    line-height: 1.2;
  }
  .arc-nl__desc {
    font-family: var(--font-body);
    font-size: 18.4px;
    color: var(--text-muted-on-dark);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .arc-nl__form {
    display: flex;
    gap: 8px;
    max-width: 420px;
    margin: 0 auto;
  }
  .arc-nl__input {
    flex: 1;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid rgba(241, 225, 221, 0.08);
    background: rgba(241, 225, 221, 0.03);
    color: var(--text-on-dark);
    font-family: var(--font-body);
    font-size: 18.4px;
    outline: none;
    transition: border-color 0.25s;
  }
  .arc-nl__input::placeholder { color: rgba(241, 225, 221, 0.25); }
  .arc-nl__input:focus { border-color: var(--accent-primary); }
  .arc-nl__btn {
    padding: 12px 24px;
    border-radius: 8px;
    border: 1px solid var(--accent-primary);
    background: var(--accent-primary);
    color: var(--bg-dark);
    font-family: var(--font-body);
    font-size: 18.4px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    white-space: nowrap;
  }
  .arc-nl__btn::before {
    content: '';
    position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(241, 225, 221, .15), transparent);
    transition: left .5s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .arc-nl__btn:hover::before { left: 100%; }
  .arc-nl__btn:hover {
    animation: arc-buzz 0.4s ease;
    box-shadow: 0 6px 20px rgba(221, 194, 159, 0.3);
  }
  .arc-nl__note {
    font-family: var(--font-body);
    font-size: 13.8px;
    color: rgba(241, 225, 221, 0.2);
    margin-top: 14px;
  }

  @media (max-width: 768px) {
    .arc-nl { padding: 40px 0; }
    .arc-nl__inner { padding: 0 20px; }
    .arc-nl__form { flex-direction: column; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "arc-section-newsletter",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay close to the Court" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Small note (optional)", "info": "Privacy note under the form" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
