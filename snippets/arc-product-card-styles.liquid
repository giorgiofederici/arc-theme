{%- comment -%}
  ════════════════════════════════════════════════
  A ROMANCE COURT — Product Card Styles
  Snippet: arc-product-card-styles
  ════════════════════════════════════════════════
  Include once in theme.liquid:
  {% render 'arc-product-card-styles' %}
  ════════════════════════════════════════════════
{%- endcomment -%}

<style>
  /* ── Float animation ── */
  @keyframes arc-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes arc-shadow-pulse {
    0%, 100% { transform: scale(1); opacity: 0.2; }
    50% { transform: scale(0.85); opacity: 0.12; }
  }

  /* ── Stagger float delays ── */
  .arc-product-card:nth-child(1) .arc-product-card__book { animation-delay: 0s; }
  .arc-product-card:nth-child(1) .arc-product-card__shadow { animation-delay: 0s; }
  .arc-product-card:nth-child(2) .arc-product-card__book { animation-delay: -0.8s; }
  .arc-product-card:nth-child(2) .arc-product-card__shadow { animation-delay: -0.8s; }
  .arc-product-card:nth-child(3) .arc-product-card__book { animation-delay: -1.6s; }
  .arc-product-card:nth-child(3) .arc-product-card__shadow { animation-delay: -1.6s; }
  .arc-product-card:nth-child(4) .arc-product-card__book { animation-delay: -2.4s; }
  .arc-product-card:nth-child(4) .arc-product-card__shadow { animation-delay: -2.4s; }

  /* ── Card wrapper ── */
  .arc-product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .arc-product-card:hover {
    transform: translateY(-4px);
  }

  /* ── Display case ── */
  .arc-product-card__display {
    background: var(--bg-surface) !important;
    border-radius: 12px 12px 0 0 !important;
    padding: 20px 14px 14px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    position: relative !important;
    height: 260px !important;
    justify-content: center !important;
    overflow: hidden !important;
    text-decoration: none !important;
    color: inherit !important;
  }
  .arc-product-card__display::before {
    content: '' !important;
    position: absolute !important;
    top: 50% !important; left: 50% !important;
    transform: translate(-50%, -55%) !important;
    width: 60% !important; height: 60% !important;
    background: radial-gradient(ellipse, rgba(221, 194, 159, 0.08) 0%, transparent 70%) !important;
    pointer-events: none !important;
  }

  /* ── Floating book ── */
  .arc-product-card__book {
    width: 130px !important;
    height: 195px !important;
    border-radius: 4px 8px 8px 4px !important;
    overflow: hidden !important;
    position: relative !important;
    z-index: 2 !important;
    flex-shrink: 0 !important;
    animation: arc-float 4s ease-in-out infinite;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 4px 4px 12px rgba(21, 29, 44, 0.12), 1px 1px 3px rgba(21, 29, 44, 0.08) !important;
  }
  .arc-product-card:hover .arc-product-card__book {
    animation-play-state: paused;
    transform: translateY(-12px) scale(1.03) !important;
    box-shadow: 6px 12px 24px rgba(21, 29, 44, 0.18), 2px 4px 8px rgba(21, 29, 44, 0.1) !important;
  }
  .arc-product-card__book::after {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important;
    width: 4px !important;
    background: linear-gradient(180deg, rgba(21, 29, 44, 0.1), rgba(21, 29, 44, 0.2), rgba(21, 29, 44, 0.1)) !important;
    pointer-events: none !important;
  }
  .arc-product-card__book img {
    width: 100% !important; height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }
  .arc-product-card__book-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    font-family: var(--font-heading);
    font-size: 16.1px;
    text-align: center;
    padding: 12px;
  }

  /* ── Shadow ── */
  .arc-product-card__shadow {
    width: 50%; height: 8px;
    background: radial-gradient(ellipse, rgba(21, 29, 44, 0.18) 0%, transparent 70%);
    border-radius: 50%;
    margin-top: 12px;
    animation: arc-shadow-pulse 4s ease-in-out infinite;
    z-index: 1;
  }
  .arc-product-card:hover .arc-product-card__shadow {
    animation-play-state: paused;
    opacity: 0.08;
    transform: scale(0.7);
  }

  /* ── Badges ── */
  .arc-product-card__badges {
    position: absolute;
    top: 12px; left: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 3;
  }
  .arc-product-card__badge {
    font-family: var(--font-body);
    font-size: 13.8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-sm, 4px);
    width: fit-content;
  }
  .arc-product-card__badge--accent { background: var(--accent-primary); color: var(--bg-primary); }
  .arc-product-card__badge--gold { background: var(--arc-sand); color: var(--arc-plum); }
  .arc-product-card__badge--rose { background: var(--accent-secondary); color: var(--arc-blush); }
  .arc-product-card__badge--dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .arc-product-card__badge--sold-out { background: var(--text-tertiary); color: var(--bg-primary); }

  /* ── Quick add ── */
  .arc-product-card__quick-add {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    transform: translateY(8px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 4;
  }
  .arc-product-card:hover .arc-product-card__quick-add {
    transform: translateY(0);
    opacity: 1;
  }

  /* ── Museum plaque ── */
  .arc-product-card__plaque {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-top: none;
    border-radius: 0 0 var(--radius-lg, 12px) var(--radius-lg, 12px);
    padding: 16px 18px;
    text-align: center;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .arc-product-card__plaque::before {
    content: '';
    position: absolute;
    top: 0; left: 20%; right: 20%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
  }
  .arc-product-card__plaque-overline {
    font-family: var(--font-body);
    font-size: 13.8px;
    color: var(--text-tertiary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .arc-product-card__plaque-title {
    font-family: var(--font-heading);
    font-size: 20.7px;
    color: var(--text-body);
    line-height: 1.2;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
  }
  .arc-product-card__plaque-tags {
    display: flex;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .arc-product-card__tag {
    font-family: var(--font-body);
    font-size: 13.8px;
    padding: 2px 8px;
    border-radius: var(--radius-sm, 4px);
    border: 1px solid;
  }
  .arc-product-card__tag--spicy { color: var(--accent-secondary); border-color: rgba(85, 41, 74, 0.2); background: rgba(85, 41, 74, 0.06); }
  .arc-product-card__tag--signed { color: var(--accent-primary); border-color: rgba(221, 194, 159, 0.2); background: rgba(221, 194, 159, 0.06); }
  .arc-product-card__tag--limited { color: var(--accent-primary); border-color: rgba(178, 170, 187, 0.2); background: rgba(178, 170, 187, 0.06); }
  .arc-product-card__plaque-divider {
    width: 40px; height: 1px;
    background: var(--border-default);
    margin: 8px auto;
  }
  .arc-product-card__plaque-price {
    font-family: var(--font-body);
    font-size: 20.7px;
    color: var(--text-heading);
  }
  .arc-product-card__plaque-price-compare {
    font-family: var(--font-body);
    font-size: 16.1px;
    color: var(--text-tertiary);
    text-decoration: line-through;
    margin-left: 6px;
  }

  /* ── Sold out ── */
  .arc-product-card--sold-out .arc-product-card__display { opacity: 0.6; }
  .arc-product-card--sold-out .arc-product-card__book { animation-play-state: paused; }
  .arc-product-card--sold-out .arc-product-card__shadow { animation-play-state: paused; }
  .arc-product-card--sold-out .arc-product-card__quick-add { display: none; }
  .arc-product-card--sold-out .arc-product-card__plaque-price { color: var(--text-tertiary); }

  /* ── Grid layouts ── */
  .arc-product-grid { display: grid; gap: 20px; }
  .arc-product-grid--4 { grid-template-columns: repeat(4, 1fr); }
  .arc-product-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .arc-product-grid--2 { grid-template-columns: repeat(2, 1fr); }

  @media (max-width: 768px) {
    .arc-product-grid--4,
    .arc-product-grid--3 { grid-template-columns: repeat(2, 1fr); }
    .arc-product-card__display { min-height: 180px; padding: 12px 10px 10px; }
    .arc-product-card__book { width: 70%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-product-card__book,
    .arc-product-card__shadow { animation: none; }
  }
</style>

<script>
  /* Quick Add to Cart — AJAX */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.arc-quick-add-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    var variantId = btn.getAttribute('data-variant-id');
    if (!variantId) return;

    var originalText = btn.innerHTML;
    btn.innerHTML = 'Adding...';
    btn.disabled = true;

    var item = { id: parseInt(variantId), quantity: 1 };

    /* Check if product requires a selling plan */
    var sellingPlanId = btn.getAttribute('data-selling-plan-id');
    if (sellingPlanId) {
      item.selling_plan = parseInt(sellingPlanId);
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [item] })
    })
    .then(function(response) {
      if (!response.ok) {
        return response.json().then(function(err) {
          /* If it fails because of selling plan, redirect to product page */
          if (err.description && err.description.indexOf('selling plan') !== -1) {
            var productUrl = btn.closest('.arc-product-card');
            if (productUrl) {
              var link = productUrl.querySelector('a[href*="/products/"]');
              if (link) { window.location.href = link.href; return; }
            }
          }
          throw new Error(err.description || 'Could not add to cart');
        });
      }
      return response.json();
    })
    .then(function() {
      btn.innerHTML = 'Added &#10003;';
      setTimeout(function() {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 1500);
      /* Update cart count in header — try both Dawn and arc selectors */
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var counts = document.querySelectorAll('.arc-nav__cart-count, .cart-count-bubble span[aria-hidden="true"], [data-cart-count]');
          counts.forEach(function(el) { el.textContent = cart.item_count; });
          /* Also dispatch event for Dawn's cart drawer */
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
        });
    })
    .catch(function(err) {
      btn.innerHTML = 'View Product';
      btn.disabled = false;
      /* On error, clicking again goes to product page */
      btn.addEventListener('click', function() {
        var card = btn.closest('.arc-product-card');
        if (card) {
          var link = card.querySelector('a[href*="/products/"]');
          if (link) window.location.href = link.href;
        }
      }, { once: true });
    });
  });
</script>
